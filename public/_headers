# Content-hashed assets are safe to cache forever and remain inexpensive.
/
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=300

# The Worker applies this policy to HTML responses as well. Keeping the static
# rule scoped avoids Cloudflare combining no-cache with immutable asset headers.
/version.json
  Cache-Control: no-cache, no-store, must-revalidate

/docs/jee-main-paper-1-2022-2026.zip
  Content-Type: application/zip
  Content-Disposition: attachment; filename="jee-main-paper-1-2022-2026.zip"
