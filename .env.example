# Public browser configuration. Leave blank for same-origin production routing.
VITE_API_URL=http://localhost:8787
VITE_MEDIA_BASE_URL=https://cdn.dekhocampus.com

# Server-only. Use the same long random value in Cloudflare and Supabase Edge Function secrets.
BLOG_AGENT_SECRET=replace_with_long_random_secret

# Optional scheduler authentication.
CRON_SECRET=replace_with_long_random_secret
