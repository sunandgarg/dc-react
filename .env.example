# Public browser configuration. Set the real values in Cloudflare Pages; never commit .env.local.
VITE_SUPABASE_URL=https://kozdctbbvrnyddlftmvf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_KEY
# Application data is served by the Node/Prisma/MySQL API. Supabase remains
# available only for the auth/storage compatibility items listed in
# docs/MIGRATION_STATUS.md.
VITE_USE_SUPABASE=no
VITE_USE_MYSQL=yes
VITE_API_URL=http://localhost:8787

# Server-only. Use the same long random value in Cloudflare and Supabase Edge Function secrets.
BLOG_AGENT_SECRET=replace_with_long_random_secret

# Optional scheduler authentication.
CRON_SECRET=replace_with_long_random_secret

# Server-only: required for complete production sitemap generation and legacy imports.
# Never expose this in VITE_ variables or commit it to Git.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
