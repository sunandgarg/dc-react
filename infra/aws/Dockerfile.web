FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_SUPABASE_STORAGE_URL
ENV VITE_SUPABASE_STORAGE_URL=$VITE_SUPABASE_STORAGE_URL
ENV SITEMAP_API_URL=none
ENV SITEMAP_SEED_URL=none
RUN npm run build

FROM nginx:1.27-alpine
COPY infra/aws/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1
