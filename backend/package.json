{
  "name": "dekhocampus-node-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "node --env-file=.env.local src/server.mjs",
    "start": "node src/server.mjs",
    "prisma:generate": "prisma generate",
    "db:push": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js db push",
    "db:setup:runtime": "node scripts/setup-runtime-database.mjs",
    "db:parity": "node --env-file-if-exists=.env.local scripts/apply-mysql-parity.mjs",
    "db:normalize:media": "node scripts/normalize-external-media.mjs",
    "verify:integrations": "node scripts/verify-production-integrations.mjs",
    "verify:production-blog": "node scripts/verify-production-blog-agent.mjs",
    "verify:production-crud": "node scripts/production-crud-regression.mjs",
    "verify:production-core": "node scripts/production-core-entity-regression.mjs",
    "verify:production-editor-review": "node scripts/production-editor-review-regression.mjs",
    "publish:cat-kit": "node scripts/publish-cat-kit.mjs",
    "repair:listed-article-covers": "node scripts/repair-listed-article-covers.mjs",
    "revoke:user-sessions": "node scripts/revoke-user-sessions.mjs",
    "reconcile:content-head": "node scripts/reconcile-content-head-access.mjs",
    "cleanup:college-editorial-artifacts": "node scripts/cleanup-college-editorial-artifacts.mjs",
    "media:build-original-manifest": "python3 scripts/build-original-college-media-manifest.py",
    "media:migrate-original": "node scripts/migrate-original-college-media.mjs",
    "media:apply-original": "node scripts/apply-original-college-media-manifest.mjs",
    "media:sanitize-original": "node scripts/sanitize-original-college-media.mjs",
    "media:build-current-carousel-cutover": "node scripts/build-current-college-carousel-cutover-manifest.mjs",
    "media:build-carousel-content-aliases": "node scripts/build-college-carousel-content-alias-manifest.mjs",
    "media:audit-original": "node scripts/audit-original-college-media-state.mjs",
    "media:retire-college-webp": "node scripts/retire-superseded-college-webp.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.887.0",
    "@aws-sdk/client-sesv2": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.887.0",
    "@prisma/client": "6.12.0",
    "mysql2": "^3.23.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "prisma": "6.12.0"
  },
  "engines": {
    "node": ">=22"
  }
}
