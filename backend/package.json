{
  "name": "dekhocampus-node-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "node --env-file=.env.local src/server.mjs",
    "start": "node src/server.mjs",
    "prisma:generate": "prisma generate",
    "db:push": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js db push",
    "db:setup:runtime": "node scripts/setup-runtime-database.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/import-mysql.mjs",
    "db:import:live-supabase": "node scripts/import-live-supabase.mjs",
    "storage:migrate:s3": "node scripts/migrate-supabase-to-s3.mjs",
    "db:parity": "node --env-file-if-exists=.env.local scripts/apply-mysql-parity.mjs",
    "schema:generate": "node scripts/generate-prisma-schema.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.887.0",
    "@aws-sdk/s3-request-presigner": "^3.887.0",
    "@prisma/client": "6.12.0",
    "mysql2": "^3.23.4"
  },
  "devDependencies": {
    "prisma": "6.12.0"
  },
  "engines": {
    "node": ">=22"
  }
}
